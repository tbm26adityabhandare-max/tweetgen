# Required: free key from console.groq.com (starts with gsk_)
GROQ_API_KEY=gsk_your-key-here
# Optional: free key from tavily.com for live web research (starts with tvly-)
TAVILY_API_KEY=
# Optional settings
GROQ_MODEL=openai/gpt-oss-120b
FREE_GENERATIONS=2
QUOTA_RESET_DAYS=30
DAILY_SITE_CAP=200
# Vercel only (free at upstash.com), so limits survive between requests:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
